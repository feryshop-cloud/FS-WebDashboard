# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Admin password (bootstrap only)
ADMIN_PASSWORD=

# Logging
# LOG_LEVEL controls structured log verbosity: debug | info | warn | error
# Default: info in production, debug in development
LOG_LEVEL=info

# Request tracing
# Clients may send x-request-id header; if omitted, a UUID is generated per request.
# The ID is echoed back in the x-request-id response header and included in every JSON log line.
# No env var needed — the header is read automatically.